{
  "name": "@agihunt/dsh-hop",
  "version": "0.3.2",
  "description": "Hop: a hop game to play while DeepSeek works, with an AI coding tip on every block / 蹦一蹦：等 DeepSeek 干活时玩的跳一跳",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/AGIHunt/cc-mods/tree/main/dsh/hop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGIHunt/cc-mods.git",
    "directory": "dsh/hop"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
